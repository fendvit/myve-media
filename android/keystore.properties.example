# TEMPLATE ONLY — do not fill this file in and do not put it next to this one.
#
# The real keystore.properties and the .jks live OUTSIDE the repo, because this
# working copy sits in a OneDrive folder: anything inside it syncs to the cloud
# and to every machine on the account. gitignore doesn't stop that, and a signing
# key is the one credential that can't be rotated.
#
# Default location (both files together):
#
#   C:\Users\<you>\.keys\myve-android\
#
# Override with the MYVE_KEYSTORE_PROPERTIES environment variable, pointing at
# the properties file itself. android/app/build.gradle and scripts/build-aab.ts
# both read that variable.
#
# To create the keystore, cd into that directory and run this as ONE line —
# no backslash continuations, they're a bash thing and PowerShell chokes on them:
#
#   keytool -genkeypair -v -keystore myve-upload.jks -alias myve-upload -keyalg RSA -keysize 2048 -validity 10000
#
# keytool prompts for the passwords and for your name/organisation. At the key
# password prompt, pressing Enter reuses the store password — that matches the
# storePassword/keyPassword pair below.
#
# Back up both files somewhere you won't lose them. Once the app is enrolled in
# Play App Signing, Google can reissue a lost upload key, but it costs days.

# Relative paths resolve next to this file, so the pair can be moved as a unit.
storeFile=myve-upload.jks
storePassword=
keyAlias=myve-upload
keyPassword=
