# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Capacitor web payload, rebuilt by `npm run sync:native`
dist-native
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local media sources (not for the repo)
generated/
photos for the new website/
SCREENSHOTS OF THE OLD WEBSITE/

# Env files — never commit secrets
.env
.env.local

# Android signing keys. android/.gitignore already covers these, but keytool is
# easy to run from the wrong directory and a signing key committed once is
# compromised for good.
*.jks
*.keystore
keystore.properties

# Local Claude Code permissions (machine-specific)
.claude/settings.local.json

# Supabase CLI scratch state (linked project ref, version checks)
supabase/.temp/
