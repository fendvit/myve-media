# Copy to .env.local and fill in real values. Never commit .env.local.

# Client-side (Vite reads these for `npm run dev`)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Portal push notifications — the PUBLIC half of the VAPID pair only.
# Generate both with: npx web-push generate-vapid-keys
# The private key belongs in Supabase secrets, never here.
VITE_VAPID_PUBLIC_KEY=""

# Server-side only — used by api/contact.ts when running `vercel dev`
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL=""
