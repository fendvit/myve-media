# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Put these in .env.local, NOT .env. Vite loads both and .env.local wins, so a
# stale .env silently shadows nothing — until .env.local is missing, and then
# the app builds against whatever .env says. A .env holding a dead project ref
# ("gewjbombgrhqlebkwcjq", the original Lovable scaffold) was deleted on
# 2026-09-13 for exactly that reason. Don't recreate it.

# Client-side (Vite reads these for `npm run dev`)
# Canonical project: "Myve Media", ref nkfefurnjhupzealopym — this is the one
# production runs against and the one supabase/config.toml declares. If these
# three ever disagree with config.toml, config.toml and prod are right.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Portal push notifications — the PUBLIC half of the VAPID pair only.
# Generate both with: npx web-push generate-vapid-keys
# The private key belongs in Supabase secrets, never here.
VITE_VAPID_PUBLIC_KEY=""

# Portal MCP server: PORTAL_MCP_TOKEN is deliberately NOT listed as a variable
# here. It lives only in Supabase secrets
# (`supabase secrets set "PORTAL_MCP_TOKEN=…"`), because it grants full access
# to every client's portal data — and anything named VITE_* would be compiled
# straight into the public browser bundle.

# Server-side only — used by api/contact.ts when running `vercel dev`
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL=""
