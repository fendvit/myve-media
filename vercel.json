{
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "host", "value": "portal.myve.media" }],
      "dest": "/portal.html"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "portal.myve.media" }],
      "dest": "/portal.html"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
