{
  "routes": [
    { "src": "/(.*)", "headers": {"X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "SAMEORIGIN", "Permissions-Policy": "camera=(), microphone=(), geolocation=()", "Content-Security-Policy-Report-Only": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https:; connect-src 'self' https:; frame-ancestors 'self'"}, "continue": true },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "portal.myve.media" }],
      "dest": "/portal.html"
    },
    {
      "src": "/(_home\\.html|projekty|jak-to-delame|zasady-ochrany-osobnich-udaju|pravni-informace|sluzby|tvorba-webu|tvorba-webu-jaromer|emailing-a-automatizace|aplikace-na-miru)(/.*)?",
      "has": [{ "type": "host", "value": "portal.myve.media" }],
      "dest": "/portal.html"
    },
    { "src": "/", "dest": "/_home.html" },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "portal.myve.media" }],
      "dest": "/portal.html"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
